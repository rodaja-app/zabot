# Copie para .env e ajuste os valores antes de rodar localmente.
NODE_ENV=development
PORT=3000

# Postgres (local: docker-compose up -d postgres)
DATABASE_URL=postgresql://zabot:zabot@localhost:5432/zabot

# Redis (local: docker-compose up -d redis) — base do BullMQ, cache e rate limiting
REDIS_URL=redis://localhost:6379

# JWT — gere segredos fortes (32+ caracteres aleatórios) antes de produção
JWT_ACCESS_SECRET=troque-por-um-segredo-forte-de-32-caracteres
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte-de-32-caracteres

# Criptografia em repouso do auth state das sessões WhatsApp (etapa 11).
# 32 bytes em hex (64 caracteres). Gerar com: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=

# Observabilidade — opcional em dev, recomendado desde já em staging/produção
SENTRY_DSN=
LOG_LEVEL=info

# CORS (etapa 18) — origens (separadas por vírgula) autorizadas a chamar a
# API via navegador com credentials, ex.: https://app.zabot.com. Vazio =
# nenhuma origem cross-site autorizada (seguro por padrão; não afeta o app
# Flutter nativo, que não passa por CORS). Só preencha se houver cliente web.
CORS_ORIGIN=

# Sharding de sessões WhatsApp (etapa 11) — opcional, ver env.validation.ts
WORKER_ID=

# Proxy por sessão (DataImpulse, etapa 12) — opcional: sem DATAIMPULSE_HOST,
# as sessões WhatsApp conectam direto (sem proxy), útil em dev local sem
# conta DataImpulse. Uma única conta serve todos os usuários — o que isola
# cada sessão é a sticky key (gerada e rotacionada pelo backend, nunca pelo
# usuário, ver ProxyConfigService).
DATAIMPULSE_HOST=gw.dataimpulse.com
DATAIMPULSE_PORT=824
DATAIMPULSE_USERNAME=
DATAIMPULSE_PASSWORD=
# HTTP usa porta 823, SOCKS5 usa 824 (default acima já é SOCKS5)
DATAIMPULSE_PROTOCOL=SOCKS5
# Duração da sessão sticky contratada no plano (min. 1, máx. 120)
DATAIMPULSE_STICKY_MINUTES=30

# Motor de contatos (etapa 13) — opcional, padrão 3. Máximo de variações de
# número (com/sem 9º dígito) testadas em lote por contato a cada verificação.
CONTACT_MAX_VERIFICATION_ATTEMPTS=3

# SMTP — envio do código de verificação por email (etapa 10). Se deixado em
# branco, o backend usa um provedor que só loga o email (dev local sem
# servidor de email configurado) em vez de falhar a subida do app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Storage de mídia de campanha (etapa 14) — opcional: sem S3_BUCKET, o
# backend salva os uploads em disco local (MEDIA_LOCAL_DIR), suficiente para
# dev local. Preencha S3_* para usar AWS S3, Cloudflare R2 ou MinIO em
# produção (Railway não tem filesystem persistente entre deploys).
S3_BUCKET=
S3_REGION=us-east-1
# Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com (e S3_REGION=auto)
# MinIO self-hosted: endpoint do servidor + S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MEDIA_LOCAL_DIR=./data/media

# Fila/envio/anti-ban (etapa 15) — todos opcionais, com padrões seguros.
# Delay humano/jitter entre envios de uma mesma sessão: sorteado entre MIN e
# MAX (ms) a cada mensagem. "WARMUP" vale enquanto a sessão tem menos de
# SEND_WARMUP_DAYS de criada; depois passa a valer "MATURE" (maior vazão).
SEND_WARMUP_DAYS=3
SEND_WARMUP_MIN_DELAY_MS=20000
SEND_WARMUP_MAX_DELAY_MS=45000
SEND_MATURE_MIN_DELAY_MS=4000
SEND_MATURE_MAX_DELAY_MS=12000
# Janela de horário permitida para envio, no fuso LOCAL do contato (derivado
# do DDD). Fora da janela, o envio é adiado para o próximo início de janela.
SEND_WINDOW_START_HOUR=8
SEND_WINDOW_END_HOUR=20
# Tentativas/backoff antes de um envio virar falha definitiva (dead-letter).
SEND_MAX_ATTEMPTS=5
SEND_BACKOFF_DELAY_MS=10000

# Carteira de créditos e cobrança Pix via Mercado Pago — sem plano mensal
# nem loja no meio: o usuário recarrega saldo (pacotes fixos a partir de
# R$20) e cada mensagem enviada debita créditos, tudo dentro deste backend.
# Opcionais: sem MERCADOPAGO_ACCESS_TOKEN, a recarga falha com erro claro
# (402) em vez de quebrar a subida do app — suficiente para dev local sem
# conta Mercado Pago. Pegue ACCESS_TOKEN/PUBLIC_KEY em "Suas integrações" >
# credenciais de produção; WEBHOOK_SECRET em "Suas integrações" > Webhooks
# (só aparece depois de configurar a URL de notificação lá).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
